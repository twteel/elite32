{
  "sections": {
    "custom_liquid_i3E7DM": {
      "type": "custom-liquid",
      "custom_css": [],
      "name": "Header + Scheduler",
      "settings": {
        "custom_liquid": "{%- comment -%}\nELITE32 HOMEPAGE — SINGLE BLOCK (v11)\nFixes:\n- Agenda layout on tablet (no twisted grid)\n- Removes duplicate image rendering (only one moments strip)\n- Press logos as a clean grid (6 logos looks intentional)\n- Keeps your video + agenda + strip + credibility + videos + pillars structure\n{%- endcomment -%}\n\n{%- comment -%} ============== CONFIG ============== {%- endcomment -%}\n\n{%- assign HERO_HEADLINE = \"ELITE 32 IS BUILT FOR <br>PROGRAMS THAT COMPETE ANYWHERE\" -%}\n{%- assign HERO_SUB = \"High-level youth and high school basketball events designed for serious teams and professional execution across multiple markets.\" -%}\n\n{%- assign PRIMARY_CTA = \"REGISTER A TEAM\" -%}\n{%- assign PRIMARY_LINK = \"/pages/register\" -%}\n\n{%- assign SECONDARY_CTA = \"LEARN MORE\" -%}\n{%- assign SECONDARY_LINK = \"/pages/about\" -%}\n\n{%- assign TERTIARY_CTA = \"VIEW SCHEDULE\" -%}\n{%- assign TERTIARY_LINK = \"#next-up\" -%}\n\n{%- assign VIDEO_ID = \"W56I9_vFs98\" -%}\n\n{%- comment -%}\nPHOTO STRIP\nURL | ALT | DESKTOP_SPAN (2–12)\n{%- endcomment -%}\n{%- capture PHOTO_STRIP -%}\nhttps://cdn.shopify.com/s/files/1/0659/5565/9835/files/20250118-NYC_Elite_32_Presents_The_MLK_Jr_Classic_2025_Game_Action_Highlight_Photos-8567.jpg?v=1771779943 | Game action | 4\nhttps://cdn.shopify.com/s/files/1/0659/5565/9835/files/NYC_Elite_32_Fall_Brawl_Boys_Girls_Next_Gen_Fall_Basketball_Classic_Game_Action_Highlight_Photos_10-25-25-8062-20251025-DxO_DeepPRIME_XD2s.jpg?v=1771779940 | Crowd | 4\nhttps://cdn.shopify.com/s/files/1/0659/5565/9835/files/NYC_Elite_32_Fall_Brawl_Boys_Girls_Next_Gen_Fall_Basketball_Classic_Game_Action_Highlight_Photos_10-25-25-3883-20251025-DxO_DeepPRIME_XD2s.jpg?v=1771779940 | Bench | 4\n{%- endcapture -%}\n\n{%- assign STRIP_TITLE = \"MOMENTS\" -%}\n{%- assign STRIP_SUB = \"\" -%}\n\n{%- assign AGENDA_TITLE = \"NEXT UP\" -%}\n{%- assign AGENDA_SUB = \"Upcoming events and registration windows. Built for coaches, teams, and coverage.\" -%}\n{%- assign MEDIA_LINK = \"/pages/media-registration\" -%}\n\n{%- comment -%}\nEVENTS\nDATE | EVENT NAME | MARKET | VENUE | TEAM LINK | MEDIA LINK | STATUS\nSTATUS: OPEN, LIMITED, TBD, PLANNED, CLOSED, INVITE-ONLY\n{%- endcomment -%}\n{%- capture EVENTS -%}\nAPRIL 4-5, 2026 | Middle School Madness | New York | South Shore HS | /pages/register | /pages/media-registration | OPEN\nJUNE 20, 2026 | ELITE32 HS ALL-STAR GAME | New York | Queens College: Fitzgerald Gymnasium | /pages/register | /pages/media-registration | INVITE-ONLY\nMAY 2026 | ELITE32 MIAMI TIP-OFF | Miami | Venue TBA | /pages/register | /pages/media-registration | PLANNED\nJUL 2026 | Summer Kick-off | New York | Queens College: Fitzgerald Gymnasium | /pages/register | /pages/media-registration | TBD\nDEC 2026 | Elite 32 Holiday Invitational | TBA | TBA | /pages/register | /pages/media-registration | PLANNED\n{%- endcapture -%}\n\n{%- assign CRED_TITLE = \"TRUSTED BY PLATFORMS<br>THAT SHAPE THE GAME\" -%}\n{%- assign CRED_SUB = \"Distribution, highlights, and real visibility. Built into operations.\" -%}\n\n{%- comment -%}\nPress logos. URL | ALT (ALT optional)\n{%- endcomment -%}\n{%- capture PRESS_LOGOS -%}\nhttps://cdn.shopify.com/s/files/1/0659/5565/9835/files/PIX11_2017.svg?v=1771779062 | PIX11\nhttps://cdn.shopify.com/s/files/1/0659/5565/9835/files/images.png?v=1771695285 | BallisLife\nhttps://assets.espn.go.com/i/espn/networks_shows/radio/crops/500/espn_new_york.png | ESPN\nhttps://cdn.shopify.com/s/files/1/0659/5565/9835/files/SLAM_Logo_2021-orange_1080x_c7baec79-91fa-4910-88a8-0573a020de32.png?v=1771695021 | SLAM\nhttps://upload.wikimedia.org/wikipedia/commons/1/12/Mass_Appeal_logo.png | Mass Appeal\nhttps://i.iheart.com/v3/re/assets.brands/67b8e5157d4fdd4e87d20c1d?ops=gravity(%22center%22),contain(600,200)&quality=80 | iHeartRadio\n{%- endcapture -%}\n\n{%- assign VIDEOS = \"\nhttps://youtu.be/cd_sFCMqHWc,\nhttps://youtu.be/E34QwURyPQQ,\nhttps://youtu.be/BInaVkmDNfM,\nhttps://youtu.be/7oJatIF5Q-Q\n\" | split: \",\" -%}\n\n<section class=\"e32-shell\" aria-label=\"Elite32 Homepage\">\n\n  <!-- HERO -->\n  <header class=\"e32-hero\">\n    <div class=\"e32-hero__media\" aria-hidden=\"true\">\n      <iframe\n        loading=\"lazy\"\n        src=\"https://www.youtube-nocookie.com/embed/{{ VIDEO_ID }}?autoplay=1&mute=1&loop=1&playlist={{ VIDEO_ID }}&controls=0&modestbranding=1&playsinline=1&rel=0&iv_load_policy=3\"\n        allow=\"autoplay; encrypted-media; picture-in-picture\"\n        title=\"Elite32 Hero Video\"\n      ></iframe>\n    </div>\n\n    <div class=\"e32-hero__overlay\" aria-hidden=\"true\"></div>\n\n    <div class=\"e32-wrap e32-hero__content\">\n      <span class=\"e32-eyebrow\">ELITE32</span>\n      <h1 class=\"e32-title\">{{ HERO_HEADLINE | newline_to_br }}</h1>\n      <p class=\"e32-lede\">{{ HERO_SUB }}</p>\n\n      <div class=\"e32-actions\" role=\"group\" aria-label=\"Primary actions\">\n        <a href=\"{{ PRIMARY_LINK }}\" class=\"e32-btn e32-btn--primary\">{{ PRIMARY_CTA }}</a>\n        <a href=\"{{ SECONDARY_LINK }}\" class=\"e32-btn e32-btn--secondary\">{{ SECONDARY_CTA }}</a>\n        <a href=\"{{ TERTIARY_LINK }}\" class=\"e32-btn e32-btn--ghost\">{{ TERTIARY_CTA }}</a>\n      </div>\n\n      <div class=\"e32-hero__meta\" aria-label=\"Highlights\">\n        <span>YOUTH FIRST</span><span class=\"e32-dot\" aria-hidden=\"true\"></span>\n        <span>BUILT FOR OPERATIONS</span><span class=\"e32-dot\" aria-hidden=\"true\"></span>\n        <span>MEDIA READY</span>\n      </div>\n    </div>\n  </header>\n\n  <!-- NEXT UP -->\n  <section id=\"next-up\" class=\"e32-block e32-agenda\" aria-label=\"Upcoming events\">\n    <div class=\"e32-wrap\">\n\n      <div class=\"e32-agenda__head\">\n        <div>\n          <h2 class=\"e32-h2\">{{ AGENDA_TITLE }}</h2>\n          <p class=\"e32-body e32-body--muted\">{{ AGENDA_SUB }}</p>\n        </div>\n\n        <div class=\"e32-agenda__headActions\">\n          <a class=\"e32-chip e32-chip--primary\" href=\"{{ PRIMARY_LINK }}\">REGISTER TEAM</a>\n          <a class=\"e32-chip\" href=\"{{ MEDIA_LINK }}\">MEDIA PASS</a>\n        </div>\n      </div>\n\n      <div class=\"e32-table\" role=\"table\" aria-label=\"Event agenda\">\n        <div class=\"e32-row e32-row--head\" role=\"row\">\n          <div role=\"columnheader\">DATE</div>\n          <div role=\"columnheader\">EVENT</div>\n          <div role=\"columnheader\" class=\"e32-row__right\">ACTIONS</div>\n        </div>\n\n        {%- assign lines = EVENTS | strip | newline_to_br | split: \"<br />\" -%}\n        {%- for l in lines -%}\n          {%- assign row = l | strip -%}\n          {%- if row != \"\" -%}\n            {%- assign parts = row | split: \" | \" -%}\n            {%- assign d = parts[0] | default: \"\" -%}\n            {%- assign name = parts[1] | default: \"\" -%}\n            {%- assign market = parts[2] | default: \"\" -%}\n            {%- assign venue = parts[3] | default: \"\" -%}\n            {%- assign team_link = parts[4] | default: PRIMARY_LINK -%}\n            {%- assign media_link = parts[5] | default: MEDIA_LINK -%}\n            {%- assign status = parts[6] | default: \"TBD\" -%}\n            {%- assign status_handle = status | strip | downcase | replace: \" \", \"-\" | replace: \"_\", \"-\" -%}\n\n            <div class=\"e32-row\" role=\"row\">\n              <div class=\"e32-date\" role=\"cell\">{{ d }}</div>\n\n              <div class=\"e32-event\" role=\"cell\">\n                <div class=\"e32-event__top\">\n                  <span class=\"e32-event__name\">{{ name }}</span>\n                  <span class=\"e32-badge e32-badge--{{ status_handle }}\">{{ status | strip }}</span>\n                </div>\n                <div class=\"e32-event__sub\">\n                  <span>{{ market }}</span>\n                  <span class=\"e32-dotSm\" aria-hidden=\"true\"></span>\n                  <span>{{ venue }}</span>\n                </div>\n              </div>\n\n              <div class=\"e32-actionsCell\" role=\"cell\">\n                <a class=\"e32-miniBtn e32-miniBtn--primary\" href=\"{{ team_link }}\">REGISTER</a>\n                <a class=\"e32-miniBtn\" href=\"{{ media_link }}\">MEDIA</a>\n              </div>\n            </div>\n          {%- endif -%}\n        {%- endfor -%}\n      </div>\n\n      <div class=\"e32-agenda__foot\">\n        <p class=\"e32-micro\">Coaches: lock your spot early. Media: request credentials for coverage and distribution.</p>\n      </div>\n\n    </div>\n  </section>\n\n  <!-- PHOTO STRIP -->\n  <section class=\"e32-block e32-photoStrip\" aria-label=\"Elite32 moments\">\n    <div class=\"e32-wrap\">\n      {% if STRIP_TITLE != blank or STRIP_SUB != blank %}\n        <header class=\"e32-photoStrip__head\">\n          {% if STRIP_TITLE != blank %}\n            <h2 class=\"e32-h2\">{{ STRIP_TITLE }}</h2>\n          {% endif %}\n          {% if STRIP_SUB != blank %}\n            <p class=\"e32-body e32-body--muted\">{{ STRIP_SUB }}</p>\n          {% endif %}\n        </header>\n      {% endif %}\n\n      <div class=\"e32-strip\">\n        {%- assign items = PHOTO_STRIP | strip | newline_to_br | split: \"<br />\" -%}\n        {%- for item in items -%}\n          {%- assign line = item | strip -%}\n          {%- if line != \"\" -%}\n            {%- assign parts = line | split: \" | \" -%}\n            {%- assign src = parts[0] | strip -%}\n            {%- assign alt = parts[1] | strip | default: \"Elite32 photo\" -%}\n            {%- assign col = parts[2] | strip | default: \"4\" -%}\n\n            <figure class=\"e32-strip__card\" style=\"grid-column: span {{ col }};\">\n              <img src=\"{{ src }}\" alt=\"{{ alt | escape }}\" loading=\"lazy\" decoding=\"async\">\n            </figure>\n          {%- endif -%}\n        {%- endfor -%}\n      </div>\n    </div>\n  </section>\n\n  <!-- CREDIBILITY -->\n  <section class=\"e32-block e32-cred\" aria-label=\"Credibility\">\n    <div class=\"e32-wrap\">\n      <p class=\"e32-kicker\">CREDIBILITY</p>\n      <h2 class=\"e32-cred__title\">{{ CRED_TITLE | newline_to_br }}</h2>\n      <p class=\"e32-cred__sub\">{{ CRED_SUB }}</p>\n\n      <div class=\"e32-press\" aria-label=\"Press and platforms\">\n        <p class=\"e32-press__eyebrow\">AS SEEN ON MAJOR PLATFORMS</p>\n\n        <div class=\"e32-pressGrid\" role=\"list\">\n          {%- assign pl = PRESS_LOGOS | strip | newline_to_br | split: \"<br />\" -%}\n          {%- for item in pl -%}\n            {%- assign line = item | strip -%}\n            {%- if line != \"\" -%}\n              {%- assign pair = line | split: \" | \" -%}\n              {%- assign src = pair[0] | strip -%}\n              {%- assign alt = pair[1] | strip | default: \"Press logo\" -%}\n              <div class=\"e32-press__logo\" role=\"listitem\">\n                <img src=\"{{ src }}\" alt=\"{{ alt }}\" loading=\"lazy\">\n              </div>\n            {%- endif -%}\n          {%- endfor -%}\n        </div>\n\n        <p class=\"e32-press__note\">We build moments, then we distribute them.</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- LATEST VIDEOS -->\n  <section class=\"e32-block e32-media\" aria-label=\"Latest videos\">\n    <div class=\"e32-wrap\">\n      <header class=\"e32-media__header\">\n        <h2 class=\"e32-h2\">LATEST FROM ELITE32</h2>\n        <p class=\"e32-body e32-body--muted\">Full games, highlights, and moments. Archived for coaches, media, and partners.</p>\n      </header>\n\n      <div class=\"e32-media__grid\">\n        {%- for url in VIDEOS -%}\n          {%- assign clean_url = url | strip -%}\n          {%- if clean_url != \"\" -%}\n            {%- assign id = clean_url | split: \"youtu.be/\" | last -%}\n            {%- assign id = id | split: \"?\" | first -%}\n            <article class=\"e32-video\" data-video-id=\"{{ id }}\">\n              <button class=\"e32-video__thumb\" type=\"button\" aria-label=\"Play video\">\n                <img class=\"e32-video__img\" src=\"https://i.ytimg.com/vi/{{ id }}/hqdefault.jpg\" alt=\"\" loading=\"lazy\">\n                <span class=\"e32-video__play\" aria-hidden=\"true\"></span>\n                <span class=\"e32-video__scrim\" aria-hidden=\"true\"></span>\n              </button>\n              <h3 class=\"e32-video__title\"><span class=\"e32-skel\" aria-hidden=\"true\"></span></h3>\n            </article>\n          {%- endif -%}\n        {%- endfor -%}\n      </div>\n    </div>\n  </section>\n\n  <!-- HOW ELITE32 OPERATES -->\n  <section class=\"e32-block e32-pillars\" aria-label=\"How Elite32 operates\">\n    <div class=\"e32-wrap\">\n      <header class=\"e32-pillars__head\">\n        <h2 class=\"e32-h2\">HOW ELITE32 OPERATES</h2>\n        <p class=\"e32-body e32-body--muted\">A scalable youth basketball platform built on access, execution, and infrastructure.</p>\n      </header>\n\n      <div class=\"e32-pillars__grid\">\n        <article class=\"e32-pillar\">\n          <h3 class=\"e32-pillar__title\">SCHOLARSHIP AND ACCESS</h3>\n          <p class=\"e32-pillar__body\">\n            Elite32 converts participation into opportunity. Through scholarships, subsidized entry points,\n            and reinvestment of event and media revenue, we reduce cost barriers without reducing standards.\n          </p>\n          <p class=\"e32-pillar__body e32-pillar__body--muted\">Access is engineered into the model, not treated as a side project.</p>\n        </article>\n\n        <article class=\"e32-pillar\">\n          <h3 class=\"e32-pillar__title\">WORLD-CLASS EVENTS</h3>\n          <p class=\"e32-pillar__body\">\n            Elite32 operates inside strong venues with professional staffing, scheduling, and structure.\n            The environment mirrors elite circuits while staying open to programs traditionally priced out.\n          </p>\n          <p class=\"e32-pillar__body e32-pillar__body--muted\">The standard stays high. The entry point stays real.</p>\n        </article>\n\n        <article class=\"e32-pillar\">\n          <h3 class=\"e32-pillar__title\">MEDIA AS INFRASTRUCTURE</h3>\n          <p class=\"e32-pillar__body\">\n            Every event is documented and archived. Full games, highlights, and credentialed access are built into\n            operations from day one, creating visibility for athletes and long-term value for the platform.\n          </p>\n          <p class=\"e32-pillar__body e32-pillar__body--muted\">Distribution is part of the system.</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n</section>\n\n<style>\n.e32-shell{\n  --pink:#ee3a68;\n\n  --bg:#060708;\n  --ink:#ffffff;\n\n  --muted:rgba(255,255,255,.84);\n  --muted2:rgba(255,255,255,.68);\n\n  --line:rgba(255,255,255,.18);\n  --line2:rgba(255,255,255,.12);\n\n  --max:1200px;\n  --gutter: clamp(16px, 4vw, 44px);\n\n  font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;\n  background: var(--bg);\n  color: var(--ink);\n\n  width:100vw;\n  margin-left:calc(50% - 50vw);\n  margin-right:calc(50% - 50vw);\n  overflow:hidden;\n}\n.e32-shell *{box-sizing:border-box}\n.e32-wrap{\n  width:min(var(--max), calc(100% - (var(--gutter) * 2)));\n  margin:0 auto;\n  padding-left:max(0px, env(safe-area-inset-left));\n  padding-right:max(0px, env(safe-area-inset-right));\n}\n\n.e32-block{padding: clamp(34px, 5vw, 64px) 0}\n\n.e32-h2{\n  font-family:\"Druk Wide Bold\",\"DrukWide\",\"Impact\",sans-serif;\n  font-size:18px;\n  letter-spacing:.20em;\n  text-transform:uppercase;\n  margin:0 0 10px;\n  color: var(--ink);\n}\n.e32-body{margin:0;font-size:14px;line-height:1.75;color:var(--muted)}\n.e32-body--muted{color:var(--muted2)}\n.e32-kicker{\n  margin:0 0 14px;\n  font-size:11px;\n  letter-spacing:.34em;\n  text-transform:uppercase;\n  color: rgba(255,255,255,.70);\n}\n\n/* HERO */\n.e32-hero{\n  position:relative;\n  min-height:92vh;\n  display:grid;\n  align-items:center;\n  overflow:hidden;\n  border-bottom:1px solid var(--line2);\n  background:#000;\n}\n.e32-hero__media{position:absolute;inset:0;background:#000}\n.e32-hero__media iframe{\n  position:absolute;top:50%;left:50%;\n  width:150%;height:150%;\n  transform:translate(-50%,-50%) scale(1.06);\n  border:0;\n  filter: contrast(1.08) saturate(1.10) brightness(1.22);\n}\n.e32-hero__overlay{\n  position:absolute; inset:0; pointer-events:none;\n  background:\n    radial-gradient(60% 40% at 40% 45%, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.30) 45%, rgba(0,0,0,0.00) 70%),\n    linear-gradient(to bottom,\n      rgba(0,0,0,1.00) 0%,\n      rgba(0,0,0,0.92) 10%,\n      rgba(0,0,0,0.55) 22%,\n      rgba(0,0,0,0.00) 36%,\n      rgba(0,0,0,0.00) 64%,\n      rgba(0,0,0,0.55) 78%,\n      rgba(0,0,0,0.92) 90%,\n      rgba(0,0,0,1.00) 100%\n    ),\n    radial-gradient(140% 120% at 50% 50%, rgba(0,0,0,0.00) 50%, rgba(0,0,0,0.65) 82%, rgba(0,0,0,0.95) 100%);\n}\n.e32-hero__content{position:relative;z-index:2;max-width:820px;padding:96px 0 84px}\n\n.e32-eyebrow{\n  display:inline-block;\n  font-size:11px;\n  letter-spacing:.36em;\n  text-transform:uppercase;\n  color:rgba(255,255,255,.82);\n  padding:9px 12px;\n  border:1px solid rgba(255,255,255,.20);\n  border-radius:999px;\n  background: rgba(0,0,0,.22);\n  backdrop-filter: blur(10px);\n}\n.e32-title{\n  font-family:\"Druk Wide Bold\",\"DrukWide\",\"Impact\",sans-serif;\n  font-size:clamp(50px,6.2vw,92px);\n  line-height:1.0;\n  margin:18px 0 12px;\n  letter-spacing:-0.01em;\n  text-transform:uppercase;\n  color:#fff;\n  text-shadow: 0 14px 44px rgba(0,0,0,.58);\n}\n.e32-lede{\n  font-size:15px;\n  line-height:1.8;\n  color:rgba(255,255,255,.90);\n  max-width:62ch;\n  margin:0 0 26px;\n  text-shadow: 0 10px 26px rgba(0,0,0,.45);\n}\n.e32-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:4px}\n.e32-btn{\n  height:48px;\n  padding:0 20px;\n  display:inline-flex;\n  align-items:center;\n  justify-content:center;\n  font-size:12px;\n  letter-spacing:.20em;\n  text-transform:uppercase;\n  border-radius:14px;\n  text-decoration:none;\n  border:1px solid transparent;\n  transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease, background-color .18s ease, filter .18s ease;\n}\n.e32-btn:hover{transform:translateY(-1px);box-shadow:0 24px 60px rgba(0,0,0,.45)}\n.e32-btn--primary{background:var(--pink);color:#fff;box-shadow: 0 18px 52px rgba(238,58,104,.28)}\n.e32-btn--secondary{background: rgba(255,255,255,.12);border-color: rgba(255,255,255,.22);color:#fff}\n.e32-btn--ghost{background: transparent;border-color: rgba(255,255,255,.22);color:#fff}\n\n.e32-hero__meta{\n  margin-top:18px;\n  display:flex;gap:10px;flex-wrap:wrap;\n  font-size:11px;\n  letter-spacing:.20em;\n  text-transform:uppercase;\n  color:rgba(255,255,255,.74);\n}\n.e32-dot{width:4px;height:4px;border-radius:999px;background:rgba(255,255,255,.55);transform:translateY(6px)}\n\n/* WHITE SECTIONS */\n.e32-block.e32-agenda,\n.e32-block.e32-cred{\n  background:#ffffff;\n  color:#0b0c0f;\n  border-top:1px solid rgba(11,12,15,.10);\n}\n.e32-agenda .e32-h2,\n.e32-cred .e32-cred__title{color:#0b0c0f;text-shadow:none}\n.e32-agenda .e32-body,\n.e32-agenda .e32-body--muted,\n.e32-agenda .e32-micro,\n.e32-cred .e32-kicker,\n.e32-cred .e32-press__eyebrow,\n.e32-cred .e32-cred__sub{\n  color: rgba(11,12,15,.72);\n}\n\n/* AGENDA */\n.e32-agenda__head{\n  display:flex;align-items:flex-end;justify-content:space-between;\n  gap:18px;margin-bottom:18px;\n}\n.e32-agenda__headActions{display:flex;gap:10px;flex-wrap:wrap}\n.e32-chip{\n  display:inline-flex;align-items:center;justify-content:center;\n  height:38px;padding:0 14px;\n  border-radius:999px;\n  border:1px solid rgba(11,12,15,.18);\n  background: rgba(11,12,15,.06);\n  text-decoration:none;\n  color:#0b0c0f;\n  font-size:11px;letter-spacing:.18em;text-transform:uppercase;\n  white-space:nowrap;\n}\n.e32-chip--primary{border-color: rgba(238,58,104,.55);background: rgba(238,58,104,.14)}\n\n.e32-table{\n  border:1px solid rgba(11,12,15,.12);\n  border-radius:20px;\n  overflow:hidden;\n  background:#fff;\n  box-shadow: 0 16px 44px rgba(0,0,0,.08);\n}\n.e32-row{\n  display:grid;\n  grid-template-columns: 180px 1fr 260px;\n  gap:14px;\n  align-items:center;\n  padding:16px 16px;\n  border-top:1px solid rgba(11,12,15,.10);\n}\n.e32-row--head{\n  border-top:none;\n  background: rgba(11,12,15,.04);\n  font-size:11px;\n  letter-spacing:.22em;\n  text-transform:uppercase;\n  color:rgba(11,12,15,.65);\n}\n.e32-row__right{justify-self:end}\n\n.e32-date{font-size:12px;letter-spacing:.20em;text-transform:uppercase;color:rgba(11,12,15,.85)}\n.e32-event__top{display:flex;gap:10px;align-items:center;flex-wrap:wrap}\n.e32-event__name{font-size:13px;letter-spacing:.18em;text-transform:uppercase;color:#0b0c0f}\n.e32-event__sub{\n  margin-top:6px;font-size:12px;color:rgba(11,12,15,.70);\n  letter-spacing:.06em;display:flex;gap:10px;align-items:center;flex-wrap:wrap;\n}\n.e32-dotSm{width:3px;height:3px;border-radius:999px;background:rgba(11,12,15,.25)}\n\n.e32-actionsCell{\n  justify-self:end;\n  display:flex;gap:12px;align-items:center;\n}\n.e32-miniBtn{\n  height:40px;\n  min-width:120px;\n  padding:0 14px;\n  border-radius:999px;\n  display:inline-flex;align-items:center;justify-content:center;\n  font-size:11px;\n  letter-spacing:.20em;\n  text-transform:uppercase;\n  text-decoration:none;\n  border:1px solid rgba(11,12,15,.18);\n  background:#fff;\n  color: rgba(11,12,15,.90);\n  transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease, filter .18s ease;\n}\n.e32-miniBtn--primary{\n  background: var(--pink);\n  border-color: var(--pink);\n  color:#fff;\n  box-shadow: 0 16px 40px rgba(238,58,104,.18);\n}\n.e32-miniBtn:hover{transform: translateY(-1px);box-shadow: 0 14px 30px rgba(0,0,0,.10)}\n.e32-miniBtn--primary:hover{filter: brightness(1.04)}\n\n.e32-badge{\n  font-size:10px;letter-spacing:.20em;text-transform:uppercase;\n  padding:6px 10px;border-radius:999px;\n  border:1px solid rgba(11,12,15,.16);\n  color:rgba(11,12,15,.72);\n  background: rgba(11,12,15,.06);\n}\n.e32-badge--open{background: rgba(238,58,104,.14);border-color: rgba(238,58,104,.60);color: rgba(11,12,15,.92)}\n.e32-badge--invite-only{background: rgba(11,12,15,.10);border-color: rgba(11,12,15,.22);color: rgba(11,12,15,.92)}\n.e32-badge--limited{background: rgba(11,12,15,.08);border-color: rgba(11,12,15,.18)}\n.e32-badge--tbd,.e32-badge--planned,.e32-badge--closed{opacity:.80}\n\n.e32-agenda__foot{margin-top:14px}\n.e32-micro{margin:0;font-size:12px;line-height:1.7;color: rgba(11,12,15,.62)}\n\n/* PHOTO STRIP */\n.e32-photoStrip{background: var(--bg); border-top:1px solid rgba(255,255,255,.12)}\n.e32-photoStrip__head{max-width:720px;margin-bottom:16px}\n.e32-strip{\n  display:grid;\n  grid-template-columns: repeat(12, minmax(0, 1fr));\n  gap:14px;\n}\n.e32-strip__card{\n  margin:0;\n  border-radius:18px;\n  overflow:hidden;\n  border:1px solid rgba(255,255,255,.14);\n  background: rgba(255,255,255,.04);\n  box-shadow: 0 18px 54px rgba(0,0,0,.45);\n  transform: translateZ(0);\n}\n.e32-strip__card img{\n  width:100%;\n  height:100%;\n  display:block;\n  aspect-ratio: 4 / 3;\n  object-fit: cover;\n  transform: scale(1.03);\n  filter: contrast(1.08) saturate(1.06) brightness(.98);\n}\n\n/* CREDIBILITY */\n.e32-cred__title{\n  margin:0 0 10px;\n  font-family:\"Druk Wide Bold\",\"DrukWide\",\"Impact\",sans-serif;\n  font-size: clamp(28px, 3.6vw, 44px);\n  line-height:1.08;\n  text-transform:uppercase;\n  letter-spacing:.03em;\n  color:#0b0c0f;\n}\n.e32-cred__sub{\n  margin:0 0 18px;\n  max-width:70ch;\n  font-size:14px;\n  line-height:1.75;\n}\n.e32-press{\n  margin-top: 12px;\n  padding-top: 18px;\n  border-top: 1px solid rgba(11,12,15,.10);\n}\n.e32-press__eyebrow{\n  margin: 0 0 14px;\n  font-size: 11px;\n  letter-spacing: .34em;\n  text-transform: uppercase;\n}\n\n/* LOGO GRID (6 logos looks clean) */\n.e32-pressGrid{\n  display:grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap:14px;\n  align-items:center;\n}\n.e32-press__logo{\n  border:1px solid rgba(11,12,15,.10);\n  background: rgba(11,12,15,.02);\n  border-radius:16px;\n  height:72px;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  padding:12px 14px;\n}\n.e32-press__logo img{max-height:34px;width:auto;max-width:100%;object-fit:contain}\n.e32-press__note{margin: 12px 0 0;font-size: 12px;line-height: 1.7;color: rgba(11,12,15,.62)}\n\n/* VIDEOS */\n.e32-media{border-top:1px solid rgba(255,255,255,.12);background: var(--bg)}\n.e32-media__header{max-width:720px;margin-bottom:22px}\n.e32-media__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}\n.e32-video{display:flex;flex-direction:column;gap:10px}\n.e32-video__thumb{\n  position:relative;\n  border:1px solid rgba(255,255,255,.16);\n  padding:0;\n  cursor:pointer;\n  background: rgba(255,255,255,.04);\n  border-radius:18px;\n  overflow:hidden;\n  box-shadow: 0 18px 54px rgba(0,0,0,.50);\n  transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;\n}\n.e32-video__img{\n  width:100%;\n  display:block;\n  aspect-ratio: 16 / 9;\n  object-fit: cover;\n  transform: scale(1.03);\n  filter: contrast(1.10) saturate(1.06) brightness(.98);\n}\n.e32-video__scrim{position:absolute;inset:0;background: radial-gradient(90% 80% at 50% 50%, rgba(0,0,0,.08), rgba(0,0,0,.62))}\n.e32-video__play{\n  position:absolute;left:14px;bottom:14px;\n  width:48px;height:48px;border-radius:999px;\n  background: rgba(0,0,0,.55);\n  border:1px solid rgba(255,255,255,.22);\n}\n.e32-video__play:before{\n  content:\"\";\n  position:absolute;top:50%;left:50%;\n  transform: translate(-40%,-50%);\n  border-left: 12px solid #fff;\n  border-top: 8px solid transparent;\n  border-bottom: 8px solid transparent;\n}\n.e32-video__thumb:hover{transform: translateY(-2px);border-color: rgba(255,255,255,.26)}\n.e32-video__title{\n  font-size:12px;line-height:1.45;letter-spacing:.10em;text-transform:uppercase;\n  color: rgba(255,255,255,.92);margin:0;min-height:18px;\n}\n.e32-skel{display:block;height: 12px;width: 72%;border-radius: 999px;background: rgba(255,255,255,.12)}\n\n/* PILLARS */\n.e32-pillars{border-top:1px solid rgba(255,255,255,.12);background: var(--bg)}\n.e32-pillars__head{max-width:720px;margin-bottom:18px}\n.e32-pillars__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}\n.e32-pillar{padding-top:16px;border-top:1px solid rgba(255,255,255,.14)}\n.e32-pillar__title{\n  font-family:\"Druk Wide Bold\",\"DrukWide\",\"Impact\",sans-serif;\n  font-size:15px;letter-spacing:.18em;text-transform:uppercase;margin:0 0 12px;\n  color: var(--ink);\n}\n.e32-pillar__body{font-size:14px;line-height:1.8;color: rgba(255,255,255,.88);margin:0 0 10px}\n.e32-pillar__body--muted{color: rgba(255,255,255,.64)}\n\n/* Reduced motion */\n@media (prefers-reduced-motion: reduce){\n  .e32-hero__media iframe{display:none}\n  .e32-hero{background:#000}\n  .e32-btn,.e32-miniBtn,.e32-video__thumb{transition:none}\n  .e32-btn:hover,.e32-miniBtn:hover,.e32-video__thumb:hover{transform:none;box-shadow:none}\n}\n\n/* Breakpoints */\n@media(max-width:1100px){\n  .e32-media__grid{grid-template-columns:repeat(2,1fr)}\n}\n\n/* Tablet: agenda becomes 2-row grid so nothing twists */\n@media (max-width: 1180px){\n  .e32-row{\n    grid-template-columns: 160px 1fr;\n    grid-template-areas:\n      \"date event\"\n      \"actions actions\";\n    gap: 12px 14px;\n    align-items: start;\n  }\n  .e32-date{grid-area: date}\n  .e32-event{grid-area: event}\n  .e32-actionsCell{\n    grid-area: actions;\n    justify-self: start;\n    width: 100%;\n    gap: 10px;\n  }\n  .e32-miniBtn{\n    flex: 1;\n    min-width: 0;\n    height: 42px;\n  }\n  .e32-row__right{justify-self: start}\n}\n\n/* General responsive */\n@media(max-width:980px){\n  .e32-row--head{display:none}\n  .e32-pillars__grid{grid-template-columns:1fr;gap:32px}\n  .e32-strip{grid-template-columns: repeat(6, minmax(0, 1fr))}\n  .e32-pressGrid{grid-template-columns: repeat(3, minmax(0, 1fr))}\n}\n@media(max-width:720px){\n  .e32-hero__content{padding:86px 0 70px}\n  .e32-btn{width:100%}\n  .e32-actions{width:100%}\n  .e32-agenda__head{align-items:flex-start}\n  .e32-agenda__headActions{width:100%}\n  .e32-chip{flex:1;min-width:0}\n\n  .e32-row{\n    grid-template-columns: 1fr;\n    grid-template-areas:\n      \"date\"\n      \"event\"\n      \"actions\";\n  }\n\n  .e32-pressGrid{grid-template-columns: repeat(2, minmax(0, 1fr))}\n}\n@media(max-width:600px){\n  .e32-media__grid{grid-template-columns:1fr}\n  .e32-strip{grid-template-columns: 1fr}\n  .e32-strip__card img{aspect-ratio: 16 / 10}\n  .e32-pressGrid{grid-template-columns: 1fr}\n  .e32-press__logo{height:64px}\n}\n</style>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", () => {\n  const cards = document.querySelectorAll(\".e32-video\");\n\n  cards.forEach(card => {\n    const id = card.getAttribute(\"data-video-id\");\n    const titleEl = card.querySelector(\".e32-video__title\");\n    const btn = card.querySelector(\".e32-video__thumb\");\n\n    if (!id || !titleEl || !btn) return;\n\n    fetch(`https://www.youtube.com/oembed?url=https://www.youtube.com/watch?v=${id}&format=json`)\n      .then(r => r.json())\n      .then(data => { titleEl.textContent = (data && data.title) ? data.title : \"ELITE32 VIDEO\"; })\n      .catch(() => { titleEl.textContent = \"ELITE32 VIDEO\"; });\n\n    btn.addEventListener(\"click\", () => {\n      const frame = document.createElement(\"div\");\n      frame.style.position = \"relative\";\n      frame.style.aspectRatio = \"16/9\";\n      frame.style.borderRadius = \"18px\";\n      frame.style.overflow = \"hidden\";\n      frame.innerHTML = `\n        <iframe\n          src=\"https://www.youtube-nocookie.com/embed/${id}?autoplay=1&playsinline=1&modestbranding=1&rel=0&iv_load_policy=3\"\n          allow=\"autoplay; encrypted-media; picture-in-picture\"\n          style=\"position:absolute;inset:0;width:100%;height:100%;border:0;\"\n          title=\"Elite32 video\"\n        ></iframe>\n      `;\n      card.replaceChild(frame, btn);\n    }, { once: true });\n  });\n});\n</script>",
