    "custom_liquid_FMzHkH": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<style>\n.elite-events {\n  padding-top: 60px;\n  padding-bottom: 60px;\n  text-align: center;\n}\n.elite-events__heading {\n  font-size: 2rem;\n  margin-bottom: 1.5rem;\n  text-transform: uppercase;\n  color: #ffffff;\n  letter-spacing: .1em;\n}\n.elite-events__grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill,minmax(280px,1fr));\n  gap: 32px;\n}\n.elite-event-card {\n  background: radial-gradient(circle at top left, #ff2e6d, #1a1a1a);\n  border-radius: 1rem;\n  padding: 32px 24px;\n  position: relative;\n  overflow: hidden;\n  transition: transform 0.3s ease;\n}\n.elite-event-card:hover {\n  transform: translateY(-4px);\n}\n.elite-event-name {\n  font-size: 1.25rem;\n  font-weight: 600;\n  margin-bottom: 0.5rem;\n  color: #fff;\n}\n.elite-event-meta {\n  font-size: 0.875rem;\n  color: #f5f5f5;\n  margin-bottom: 1.5rem;\n}\n.elite-event-btn {\n  display: inline-block;\n  background: #ffffff;\n  color: #0a0a0a;\n  padding: 10px 20px;\n  border-radius: 9999px;\n  font-weight: 600;\n  text-decoration: none;\n  transition: background 0.2s, color 0.2s;\n}\n.elite-event-btn:hover {\n  background: #ff2e6d;\n  color: #fff;\n}\n</style>\n{% assign events = shop.metaobjects.event.values | where: \"fields.status.value\", \"Open\" %}\n{% assign featured = events | where: \"fields.featured.value\", true | sort: \"fields.sort.value\" %}\n{% if featured.size > 0 %}\n<div class=\"elite-events\">\n  <h2 class=\"elite-events__heading\">Upcoming Events</h2>\n  <div class=\"elite-events__grid\">\n    {% for event in featured %}\n    <div class=\"elite-event-card\">\n      <div class=\"elite-event-name\">{{ event.fields.name.value }}</div>\n      <div class=\"elite-event-meta\">{{ event.fields.date_range.value }} – {{ event.fields.location.value }}</div>\n      <a href=\"/pages/register-a-team?event_id={{ event.fields.event_id.value }}\" class=\"elite-event-btn\">Register</a>\n    </div>\n    {% endfor %}\n  </div>\n</div>\n{% endif %}",
        "color_scheme": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
