{%- comment -%}
ELITE32 ABOUT PAGE — SINGLE BLOCK (v5)
Balance + rhythm upgrade. Image-led sections + stat strip + mosaic gallery.
Paste into: Theme Editor -> Pages -> About -> Add section -> Custom Liquid
Edit ONLY the CONFIG section.
{%- endcomment -%}

{%- comment -%} ============== CONFIG (edit) ============== {%- endcomment -%}
{%- assign HERO_HEADLINE = "MADE FOR<br>REAL" -%}
{%- assign HERO_SUB = "Elite 32 is a year-round youth basketball platform built for access, visibility, and real outcomes. We operate at scale, professionally, consistently, and with intention." -%}

{%- assign PRIMARY_CTA = "REGISTER A TEAM" -%}
{%- assign PRIMARY_LINK = "/pages/register" -%}
{%- assign SECONDARY_CTA = "MEDIA PASS" -%}
{%- assign SECONDARY_LINK = "/pages/media-registration" -%}

{%- assign HERO_IMAGE = "https://www.elite32.org/wp-content/uploads/2025/02/PJCheri-2312287969-scaled.jpg" -%}

{%- assign IMG_1 = "https://cdn.shopify.com/s/files/1/0659/5565/9835/files/Honored._Inspired._Locked_in_Blessed_to_be_a_part_of_another_ballin4peace_x_nycelite32_event.jpg?v=1771788616" -%}
{%- assign IMG_2 = "https://cdn.shopify.com/s/files/1/0659/5565/9835/files/Another_milestone_for_NYC_hoops_Our_ballin4peace_nycelite32_Fall_Brawl_Classic_brought_toge.jpg?v=1771788616" -%}
{%- assign IMG_3 = "https://cdn.shopify.com/s/files/1/0659/5565/9835/files/01214129-scaled.jpg?v=1771793013" -%}

{%- capture TIMELINE -%}
FEB | Prep Showcase | High school and prep exposure event.
APRIL | Middle School Madness | NCAA-style youth tournament experience.
JUNE | Annual Celebrity All-Star Event | Flagship cultural and scholarship moment.
JULY | Summer Invitational | Large-scale multi-court competition.
OCT | Fall Brawl | Preseason showcase.
DEC | Holiday Invitational | Two-week varsity showcase.
{%- endcapture -%}

<section class="e32p" aria-label="Elite32 About">

  <!-- HERO -->
  <header class="e32p-hero">
    {%- if HERO_IMAGE != blank -%}
      <div class="e32p-heroMedia" aria-hidden="true">
        <img src="{{ HERO_IMAGE }}" alt="" loading="eager">
      </div>
    {%- endif -%}
    <div class="e32p-heroOverlay" aria-hidden="true"></div>

    <div class="e32p-wrap e32p-heroInner">
      <div class="e32p-heroTop">
        <span class="e32p-kicker">ELITE32</span>
        <span class="e32p-kicker e32p-kicker--ghost">YEAR-ROUND PLATFORM</span>
      </div>

      <h1 class="e32p-h1">{{ HERO_HEADLINE }}</h1>
      <p class="e32p-sub">{{ HERO_SUB }}</p>

      <div class="e32p-actions" role="group" aria-label="About page actions">
        <a class="e32p-btn e32p-btn--primary" href="{{ PRIMARY_LINK }}">{{ PRIMARY_CTA }}</a>
        <a class="e32p-btn e32p-btn--ghost" href="{{ SECONDARY_LINK }}">{{ SECONDARY_CTA }}</a>
      </div>

      <div class="e32p-meta" aria-label="Highlights">
        <span>ACCESS</span><span class="e32p-dot" aria-hidden="true"></span>
        <span>PRODUCTION</span><span class="e32p-dot" aria-hidden="true"></span>
        <span>DISTRIBUTION</span><span class="e32p-dot" aria-hidden="true"></span>
        <span>IMPACT</span>
      </div>
    </div>
  </header>

  <!-- BODY -->
  <div class="e32p-body">

    <!-- STAT STRIP -->
    <section class="e32p-strip" aria-label="Quick credibility">
      <div class="e32p-wrap e32p-stripInner">
        <div class="e32p-stat">
          <div class="e32p-statTop">MULTI-COURT</div>
          <div class="e32p-statMain">Built to run clean at scale.</div>
        </div>
        <div class="e32p-stat">
          <div class="e32p-statTop">MEDIA BUILT-IN</div>
          <div class="e32p-statMain">Coverage is infrastructure.</div>
        </div>
        <div class="e32p-stat">
          <div class="e32p-statTop">CONSISTENT STANDARD</div>
          <div class="e32p-statMain">Same experience, every time.</div>
        </div>
      </div>
    </section>

    <!-- FEATURE: The Shift -->
    <section class="e32p-sec" aria-label="The shift">
      <div class="e32p-wrap">
        <div class="e32p-head">
          <p class="e32p-eyebrow">THE SHIFT</p>
          <h2 class="e32p-h2">The game changed. Access did not.</h2>
        </div>

        <div class="e32p-feature">
          <div class="e32p-featureMedia">
            <div class="e32p-mediaCard e32p-mediaCard--tall">
              <img src="{{ IMG_1 }}" alt="" loading="lazy">
              <div class="e32p-mediaCap">Premium environment. Consistent standard.</div>
            </div>
          </div>

          <div class="e32p-featureBody">
            <div class="e32p-prose">
              <p>
                Basketball is evaluated, shared, and discovered in real time. Highlights, livestreams, and digital visibility influence opportunity as much as performance on the court.
                Yet most student-athletes still compete in environments that do not reflect how the modern game is consumed or assessed.
              </p>
              <p class="e32p-strong">Elite 32 exists to close that gap.</p>
            </div>

            <div class="e32p-box">
              <div class="e32p-boxTitle">What we deliver</div>
              <ul class="e32p-list">
                <li><span class="e32p-check" aria-hidden="true"></span>Professional venues</li>
                <li><span class="e32p-check" aria-hidden="true"></span>Structured competition</li>
                <li><span class="e32p-check" aria-hidden="true"></span>Built-in media visibility</li>
                <li><span class="e32p-check" aria-hidden="true"></span>Standards that stay consistent</li>
              </ul>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- FEATURE: Built to Scale -->
    <section class="e32p-sec e32p-sec--tint" aria-label="Built to scale">
      <div class="e32p-wrap">
        <div class="e32p-head">
          <p class="e32p-eyebrow">BUILT TO SCALE</p>
          <h2 class="e32p-h2">A platform, not a tournament.</h2>
        </div>

        <div class="e32p-feature e32p-feature--flip">
          <div class="e32p-featureMedia">
            <div class="e32p-mediaCard e32p-mediaCard--tall">
              <img src="{{ IMG_2 }}" alt="" loading="lazy">
              <div class="e32p-mediaCap">Scheduling. Staffing. Repeatable execution.</div>
            </div>
          </div>

          <div class="e32p-featureBody">
            <div class="e32p-prose">
              <p>
                Elite 32 operates a structured, year-round competitive ecosystem designed to mirror how the game actually works today.
                We deliver professional venues, real scheduling, staffing, and consistent media output across the calendar.
              </p>
            </div>

            <div class="e32p-box">
              <div class="e32p-boxTitle">The standard</div>
              <p class="e32p-muted">Not built for one event. Built to operate.</p>
              <div class="e32p-pills" aria-label="Pill list">
                <span class="e32p-pill">Year-round</span>
                <span class="e32p-pill">Multi-court</span>
                <span class="e32p-pill">Media built-in</span>
                <span class="e32p-pill">Culture-first</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- MOSAIC GALLERY MOMENT -->
    <section class="e32p-sec" aria-label="Gallery">
      <div class="e32p-wrap">
        <div class="e32p-head">
          <p class="e32p-eyebrow">THE ENVIRONMENT</p>
          <h2 class="e32p-h2">Proof of execution.</h2>
        </div>

        <div class="e32p-mosaic" role="list" aria-label="About gallery">
          <div class="e32p-mosaicA" role="listitem">
            <img src="{{ IMG_3 }}" alt="" loading="lazy">
          </div>
          <div class="e32p-mosaicB" role="listitem">
            <img src="{{ IMG_1 }}" alt="" loading="lazy">
          </div>
          <div class="e32p-mosaicC" role="listitem">
            <img src="{{ IMG_2 }}" alt="" loading="lazy">
          </div>
        </div>

        <div class="e32p-mosaicNote">
          <span class="e32p-badge">REAL VENUES</span>
          <span class="e32p-badge">REAL OPERATIONS</span>
          <span class="e32p-badge">REAL OUTPUT</span>
        </div>
      </div>
    </section>

    <!-- CALENDAR -->
    <section class="e32p-sec e32p-sec--tint" aria-label="Calendar">
      <div class="e32p-wrap">
        <div class="e32p-head">
          <p class="e32p-eyebrow">THE CALENDAR</p>
          <h2 class="e32p-h2">A year-round competitive ecosystem.</h2>
        </div>

        <div class="e32p-table" role="list" aria-label="Elite32 yearly calendar">
          {%- assign lines = TIMELINE | strip | newline_to_br | split: "<br />" -%}
          {%- for l in lines -%}
            {%- assign row = l | strip -%}
            {%- if row != "" -%}
              {%- assign parts = row | split: " | " -%}
              {%- assign when = parts[0] | strip -%}
              {%- assign title = parts[1] | strip -%}
              {%- assign desc = parts[2] | strip -%}
              <div class="e32p-row" role="listitem">
                <div class="e32p-when">{{ when }}</div>
                <div class="e32p-main">
                  <div class="e32p-title">{{ title }}</div>
                  <div class="e32p-desc">{{ desc }}</div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <p class="e32p-muted e32p-after">Every activation builds on the last. Visibility compounds. Standards remain consistent.</p>
      </div>
    </section>

    <!-- MEDIA -->
    <section class="e32p-sec" aria-label="Media">
      <div class="e32p-wrap">
        <div class="e32p-head">
          <p class="e32p-eyebrow">MEDIA AS INFRASTRUCTURE</p>
          <h2 class="e32p-h2">Built for visibility at scale.</h2>
        </div>

        <div class="e32p-feature">
          <div class="e32p-featureMedia">
            <div class="e32p-mediaCard e32p-mediaCard--wide">
              <img src="{{ IMG_3 }}" alt="" loading="lazy">
              <div class="e32p-mediaCap">Livestream. Highlights. Archive. Distribution.</div>
            </div>
          </div>

          <div class="e32p-featureBody">
            <div class="e32p-prose">
              <p>
                Elite 32 is structured around how basketball is discovered today. Every event is designed to generate real-time coverage and long-tail value.
                Flagship moments reach major platforms through momentum, not paid boosts.
              </p>
            </div>

            <div class="e32p-box">
              <div class="e32p-boxTitle">Outputs</div>
              <ul class="e32p-list">
                <li><span class="e32p-check" aria-hidden="true"></span>Livestreamed games</li>
                <li><span class="e32p-check" aria-hidden="true"></span>Highlights and athlete reposts</li>
                <li><span class="e32p-check" aria-hidden="true"></span>Archived footage for coaches</li>
                <li><span class="e32p-check" aria-hidden="true"></span>Earned media moments</li>
              </ul>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- VALUES -->
    <section class="e32p-sec e32p-sec--tint" aria-label="What we stand for">
      <div class="e32p-wrap">
        <div class="e32p-head">
          <p class="e32p-eyebrow">WHAT WE STAND FOR</p>
          <h2 class="e32p-h2">Systems that create outcomes.</h2>
        </div>

        <div class="e32p-cards" role="list" aria-label="Values">
          <div class="e32p-card" role="listitem"><div class="e32p-cardTitle">Access</div><div class="e32p-cardDesc">College-level venues and premium environments across the calendar.</div></div>
          <div class="e32p-card" role="listitem"><div class="e32p-cardTitle">Production</div><div class="e32p-cardDesc">Multi-court livestreaming, highlights, and archival footage.</div></div>
          <div class="e32p-card" role="listitem"><div class="e32p-cardTitle">Distribution</div><div class="e32p-cardDesc">Organic reach powered by athletes, families, and culture.</div></div>
          <div class="e32p-card" role="listitem"><div class="e32p-cardTitle">Impact</div><div class="e32p-cardDesc">Scholarship funding and real outcomes for families.</div></div>
          <div class="e32p-card" role="listitem"><div class="e32p-cardTitle">Experience</div><div class="e32p-cardDesc">Elevated standards for athletes, coaches, media, and partners.</div></div>
          <div class="e32p-card" role="listitem"><div class="e32p-cardTitle">Consistency</div><div class="e32p-cardDesc">The same standard every time. No randomness.</div></div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="e32p-cta" aria-label="Call to action">
      <div class="e32p-wrap e32p-ctaInner">
        <div>
          <p class="e32p-ctaKicker">READY WHEN YOU ARE</p>
          <h2 class="e32p-ctaTitle">Register early. Build your season.</h2>
          <p class="e32p-ctaSub">Coaches lock spots early. Media request credentials for coverage and distribution.</p>
        </div>
        <div class="e32p-ctaActions" role="group" aria-label="CTA actions">
          <a class="e32p-btn e32p-btn--primary" href="{{ PRIMARY_LINK }}">REGISTER A TEAM</a>
          <a class="e32p-btn e32p-btn--ghost" href="{{ SECONDARY_LINK }}">MEDIA PASS</a>
        </div>
      </div>
    </section>

    <section class="e32p-foot" aria-label="Footer note">
      <div class="e32p-wrap">
        <p class="e32p-footNote">Elite 32 is built for long-term impact, cultural relevance, and professional operations.</p>
      </div>
    </section>

  </div>

</section>

<style>
.e32p{
  --pink:#ee3a68;
  --ink:#0b0c0f;
  --bg:#ffffff;
  --tint:#f7f7f8;
  --hair:rgba(11,12,15,.08);
  --line:rgba(11,12,15,.10);
  --muted:rgba(11,12,15,.62);
  --max:1180px;
  --gutter: clamp(18px, 4vw, 46px);

  font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
  width:100vw;
  margin-left:calc(50% - 50vw);
  margin-right:calc(50% - 50vw);
  background: var(--bg);
  color: var(--ink);
  overflow:hidden;
}
.e32p *{box-sizing:border-box}
.e32p a{color:inherit}
.e32p-wrap{
  width:min(var(--max), calc(100% - (var(--gutter) * 2)));
  margin:0 auto;
  padding-left:max(0px, env(safe-area-inset-left));
  padding-right:max(0px, env(safe-area-inset-right));
}

/* HERO */
.e32p-hero{
  position:relative;
  min-height: clamp(620px, 82vh, 900px);
  overflow:hidden;
  background: #0b0c0f;
  color:#fff;
}
.e32p-heroMedia{position:absolute;inset:0}
.e32p-heroMedia img{
  width:100%;height:100%;
  object-fit:cover;
  filter: contrast(1.07) saturate(1.05);
  transform: scale(1.03);
}
.e32p-heroOverlay{
  position:absolute;inset:0;
  background:
    radial-gradient(980px 620px at 22% 26%, rgba(255,255,255,.10), rgba(0,0,0,.92)),
    linear-gradient(180deg, rgba(0,0,0,.76), rgba(0,0,0,.22) 46%, rgba(0,0,0,.88));
}
.e32p-heroInner{
  position:relative;
  z-index:2;
  min-height: inherit;
  display:flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: clamp(110px, 12vh, 150px) 0 84px;
  max-width: 860px;
}
.e32p-heroTop{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px}
.e32p-kicker{
  display:inline-flex;
  align-items:center;
  height:34px;
  padding:0 12px;
  border-radius:999px;
  border:1px solid rgba(255,255,255,.18);
  background: rgba(255,255,255,.06);
  font-size:11px;
  letter-spacing:.30em;
  text-transform:uppercase;
  color: rgba(255,255,255,.82);
}
.e32p-kicker--ghost{background: rgba(0,0,0,.22);}

.e32p-h1{
  margin: 10px 0 12px;
  font-family:"Druk Wide Bold","DrukWide","Impact",sans-serif;
  font-size: clamp(46px, 6vw, 90px);
  line-height: 1.0;
  letter-spacing: -0.01em;
  text-transform: uppercase;
}
.e32p-sub{
  margin: 0 0 26px;
  font-size: 15px;
  line-height: 1.9;
  color: rgba(255,255,255,.76);
  max-width: 72ch;
}
.e32p-actions{display:flex;gap:12px;flex-wrap:wrap}
.e32p-btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  height:46px;
  padding:0 18px;
  border-radius: 14px;
  text-decoration:none;
  font-size:12px;
  letter-spacing:.18em;
  text-transform:uppercase;
  border:1px solid transparent;
  transition: transform .18s ease, background-color .18s ease, border-color .18s ease;
}
.e32p-btn:focus{outline:none}
.e32p-btn:focus-visible{box-shadow: 0 0 0 4px rgba(238,58,104,.25);}
.e32p-btn:hover{transform: translateY(-1px)}
.e32p-btn--primary{background: var(--pink); border-color: var(--pink); color:#fff}
.e32p-btn--ghost{background: rgba(255,255,255,.08); border-color: rgba(255,255,255,.18); color:#fff}
.e32p-btn--ghost:hover{background: rgba(255,255,255,.11)}
.e32p-meta{
  margin-top: 18px;
  display:flex;
  gap: 10px;
  flex-wrap: wrap;
  font-size: 11px;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: rgba(255,255,255,.58);
}
.e32p-dot{
  width:4px;height:4px;border-radius:999px;
  background: rgba(255,255,255,.36);
  transform: translateY(6px);
}

/* STRIP */
.e32p-strip{
  background: #0b0c0f;
  color:#fff;
  border-top: 1px solid rgba(255,255,255,.08);
  border-bottom: 1px solid rgba(255,255,255,.08);
}
.e32p-stripInner{
  padding: 22px 0;
  display:grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}
.e32p-stat{
  border: 1px solid rgba(255,255,255,.10);
  background: rgba(255,255,255,.04);
  border-radius: 16px;
  padding: 14px 14px;
}
.e32p-statTop{
  font-size: 11px;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: rgba(255,255,255,.70);
  margin-bottom: 6px;
}
.e32p-statMain{
  font-size: 13px;
  line-height: 1.5;
  color: rgba(255,255,255,.86);
}

/* SECTIONS */
.e32p-body{background: var(--bg)}
.e32p-sec{padding: clamp(58px, 6vw, 98px) 0}
.e32p-sec--tint{
  background: var(--tint);
  border-top: 1px solid rgba(11,12,15,.06);
  border-bottom: 1px solid rgba(11,12,15,.06);
}
.e32p-head{max-width: 74ch; margin-bottom: 24px}
.e32p-eyebrow{
  margin:0 0 10px;
  font-size:11px;
  letter-spacing:.32em;
  text-transform:uppercase;
  color: rgba(11,12,15,.52);
}
.e32p-h2{
  margin:0;
  font-size: clamp(24px, 3vw, 40px);
  line-height: 1.12;
  letter-spacing: -0.01em;
  font-weight: 650;
  color: #0b0c0f;
}
.e32p-prose p{
  margin:0 0 12px;
  font-size: 15px;
  line-height: 1.95;
  color: rgba(11,12,15,.72);
}
.e32p-strong{font-weight:700;color:#0b0c0f}
.e32p-muted{color: var(--muted); font-size:14px; line-height:1.9; margin:0}
.e32p-after{margin-top:18px}

/* FEATURE LAYOUT */
.e32p-feature{
  display:grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(16px, 3vw, 34px);
  align-items: start;
}
.e32p-feature--flip .e32p-featureMedia{order: 2}
.e32p-featureMedia{position:sticky; top: 18px}
.e32p-featureBody{display:flex;flex-direction:column;gap:14px}

/* MEDIA */
.e32p-mediaCard{
  border: 1px solid rgba(11,12,15,.10);
  border-radius: 20px;
  overflow:hidden;
  background: #fff;
  box-shadow: 0 18px 34px rgba(0,0,0,.06);
}
.e32p-mediaCard img{
  width:100%;
  height:auto;
  display:block;
  object-fit:cover;
}
.e32p-mediaCard--tall img{aspect-ratio: 4/5}
.e32p-mediaCard--wide img{aspect-ratio: 16/10}
.e32p-mediaCap{
  padding: 12px 14px;
  font-size: 11px;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: rgba(11,12,15,.62);
  border-top: 1px solid rgba(11,12,15,.08);
  background: #fff;
}

/* BOX */
.e32p-box{
  border: 1px solid rgba(11,12,15,.10);
  border-radius: 18px;
  background: rgba(255,255,255,.78);
  padding: 16px;
}
.e32p-sec--tint .e32p-box{background: rgba(255,255,255,.90)}
.e32p-boxTitle{
  margin:0 0 10px;
  font-size:12px;
  letter-spacing:.18em;
  text-transform:uppercase;
  color: rgba(11,12,15,.72);
}

.e32p-list{margin:0;padding:0;list-style:none;display:grid;gap:10px}
.e32p-list li{
  display:flex;
  gap:10px;
  align-items:flex-start;
  font-size:14px;
  line-height:1.6;
  color: rgba(11,12,15,.72);
}
.e32p-check{
  width:18px;height:18px;border-radius:6px;
  background: rgba(238,58,104,.10);
  border: 1px solid rgba(238,58,104,.22);
  position:relative;
  flex:0 0 auto;
  margin-top:2px;
}
.e32p-check:after{
  content:"";
  position:absolute;
  left:6px;top:4px;
  width:5px;height:9px;
  border-right:2px solid rgba(238,58,104,.84);
  border-bottom:2px solid rgba(238,58,104,.84);
  transform: rotate(40deg);
}
.e32p-pills{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.e32p-pill{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  height:32px;
  padding:0 12px;
  border-radius:999px;
  border: 1px solid rgba(11,12,15,.10);
  background: rgba(11,12,15,.03);
  color: rgba(11,12,15,.72);
  font-size:11px;
  letter-spacing:.14em;
  text-transform:uppercase;
}

/* MOSAIC */
.e32p-mosaic{
  display:grid;
  grid-template-columns: 1.15fr .85fr;
  grid-template-rows: 280px 280px;
  gap: 14px;
}
.e32p-mosaic > div{
  border-radius: 20px;
