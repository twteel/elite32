/* ================================
   V5 TUNING — shrink tall media
   Paste at the very bottom of <style>
================================ */

/* Don’t let the sticky media column become a billboard */
.e32p-featureMedia{
  top: 12px;              /* less “stuck” */
}
.e32p-mediaCard{
  max-width: 520px;       /* keeps it elegant on wide screens */
  margin-left: auto;
}

/* Reduce the tall card aspect ratio (was 4/5) */
.e32p-mediaCard--tall img{
  aspect-ratio: 5 / 6;    /* shorter than 4/5 */
  max-height: 520px;      /* hard cap */
}

/* Reduce wide card height slightly too */
.e32p-mediaCard--wide img{
  aspect-ratio: 16 / 9;   /* slightly shorter */
  max-height: 420px;
}

/* Tighten the mosaic heights (was 280/280) */
.e32p-mosaic{
  grid-template-rows: 240px 240px;
}

/* On very large screens, keep media from getting huge */
@media (min-width: 1280px){
  .e32p-mediaCard--tall img{ max-height: 500px; }
  .e32p-mosaic{ grid-template-rows: 230px 230px; }
}

/* On tablets, avoid giant images and reduce gaps */
@media (max-width: 980px){
  .e32p-mediaCard{ max-width: 100%; }
  .e32p-mediaCard--tall img{ max-height: 440px; }
  .e32p-mosaic{ grid-template-rows: auto; }
}

